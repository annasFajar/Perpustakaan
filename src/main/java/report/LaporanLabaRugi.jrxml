                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["(Rp " + String.format("%,.0f",
                        ($P{TOTAL_HPP} == null ? 0.0 : $P{TOTAL_HPP}) +
                        ($P{TOTAL_PEMBELIAN} == null ? 0.0 : $P{TOTAL_PEMBELIAN})
                    ) + ")"]]>
                </textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="185" width="535" height="1"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="187" width="350" height="22" backcolor="#FFFFCC" mode="Opaque"/>
                <box><pen lineWidth="1.0"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[   LABA / RUGI BERSIH]]></text>
            </staticText>
            <textField>
                <reportElement x="350" y="187" width="185" height="22" backcolor="#FFFFCC" mode="Opaque"/>
                <box><pen lineWidth="1.0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[
                    (($P{TOTAL_PENDAPATAN} == null ? 0.0 : $P{TOTAL_PENDAPATAN})
                     - ($P{TOTAL_HPP} == null ? 0.0 : $P{TOTAL_HPP})
                     - ($P{TOTAL_PEMBELIAN} == null ? 0.0 : $P{TOTAL_PEMBELIAN})) >= 0
                    ? "LABA  Rp " + String.format("%,.0f",
                          ($P{TOTAL_PENDAPATAN} == null ? 0.0 : $P{TOTAL_PENDAPATAN})
                        - ($P{TOTAL_HPP} == null ? 0.0 : $P{TOTAL_HPP})
                        - ($P{TOTAL_PEMBELIAN} == null ? 0.0 : $P{TOTAL_PEMBELIAN}))
                    : "RUGI  (Rp " + String.format("%,.0f", Math.abs(
                          ($P{TOTAL_PENDAPATAN} == null ? 0.0 : $P{TOTAL_PENDAPATAN})
                        - ($P{TOTAL_HPP} == null ? 0.0 : $P{TOTAL_HPP})
                        - ($P{TOTAL_PEMBELIAN} == null ? 0.0 : $P{TOTAL_PEMBELIAN}))) + ")"
                    ]]>
