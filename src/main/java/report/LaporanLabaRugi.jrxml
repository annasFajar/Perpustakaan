<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
"http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="LaporanLabaRugi"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20">

    <parameter name="BULAN"              class="java.lang.Integer"/>
    <parameter name="TAHUN"              class="java.lang.Integer"/>
    <parameter name="TOTAL_PENDAPATAN"   class="java.lang.Double"/>
    <parameter name="TOTAL_HPP"          class="java.lang.Double"/>
    <parameter name="TOTAL_PEMBELIAN"    class="java.lang.Double"/>
    <parameter name="JML_TRANSAKSI_JUAL" class="java.lang.Integer"/>
    <parameter name="JML_TRANSAKSI_BELI" class="java.lang.Integer"/>

    <queryString>
        <![CDATA[
        SELECT
            pj.No_Nota,
            pj.Tanggal_Penjualan,
            pj.Nama_Pembeli,
            pj.Total                                    AS Pendapatan,
            COALESCE(hpp.HPP_Transaksi, 0)              AS HPP,
            pj.Total - COALESCE(hpp.HPP_Transaksi, 0)  AS LabaKotor,
            pg.Nama_Pegawai
        FROM penjualan pj
        LEFT JOIN pegawai pg ON pj.ID_Pegawai = pg.ID_Pegawai
        LEFT JOIN (
            SELECT dp.ID_Penjualan,
                   SUM(dp.Qty * b.Harga_Beli) AS HPP_Transaksi
            FROM detail_penjualan dp
            JOIN barang b ON dp.ID_Barang = b.ID_Barang
            GROUP BY dp.ID_Penjualan
        ) hpp ON pj.ID_Penjualan = hpp.ID_Penjualan
        WHERE MONTH(pj.Tanggal_Penjualan) = $P{BULAN}
          AND YEAR(pj.Tanggal_Penjualan)  = $P{TAHUN}
        ORDER BY pj.Tanggal_Penjualan ASC
        ]]>
    </queryString>

    <field name="No_Nota"           class="java.lang.String"/>
    <field name="Tanggal_Penjualan" class="java.sql.Date"/>
    <field name="Nama_Pembeli"      class="java.lang.String"/>
    <field name="Pendapatan"        class="java.lang.Double"/>
    <field name="HPP"               class="java.lang.Double"/>
    <field name="LabaKotor"         class="java.lang.Double"/>
    <field name="Nama_Pegawai"      class="java.lang.String"/>

    <variable name="SumPendapatan" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{Pendapatan}]]></variableExpression>
    </variable>
    <variable name="SumHPP" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{HPP}]]></variableExpression>
    </variable>
    <variable name="SumLabaKotor" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{LabaKotor}]]></variableExpression>
    </variable>

