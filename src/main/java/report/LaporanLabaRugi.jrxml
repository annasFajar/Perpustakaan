                </textElement>
                <textFieldExpression>
                    <![CDATA["(Rp " + String.format("%,.0f", $P{TOTAL_PEMBELIAN} == null ? 0.0 : $P{TOTAL_PEMBELIAN}) + ")"]]>
                </textFieldExpression>
