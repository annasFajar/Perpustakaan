                <textElement textAlignment="Right">
                    <font fontName="Times New Roman" size="9"/>
                </textElement>
                <text><![CDATA[Petugas Laporan,]]></text>
            </staticText>

            <!-- Garis tanda tangan kiri -->
            <staticText>
