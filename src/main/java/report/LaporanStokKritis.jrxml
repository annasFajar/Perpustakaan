            </staticText>
            <staticText>
                <reportElement x="298" y="0" width="35"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[STOK]]></text>
            </staticText>
            <staticText>
                <reportElement x="333" y="0" width="40"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[STOK MIN]]></text>
            </staticText>
            <staticText>
                <reportElement x="373" y="0" width="40"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[KURANG]]></text>
            </staticText>
            <staticText>
                <reportElement x="413" y="0" width="60"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[HARGA BELI]]></text>
            </staticText>
            <staticText>
                <reportElement x="473" y="0" width="62"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[HARGA JUAL]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ═══════════ DETAIL ═══════════ -->
    <detail>
        <band height="16">
            <!-- Warna bergantian: putih dan merah muda -->
            <textField>
                <reportElement x="0"   y="0" width="18"  height="16"
                    backcolor="#FFFFFF" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="18"  y="0" width="55"  height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{Kode_Barang}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="73"  y="0" width="100" height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{Nama_Barang} + " (" + ($F{Merk} == null ? "-" : $F{Merk}) + ")"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="173" y="0" width="60"  height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{Nama_Kategori}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="233" y="0" width="65"  height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{Nama_Supplier}]]></textFieldExpression>
            </textField>

            <!-- Stok — merah jika 0 -->
            <textField>
                <reportElement x="298" y="0" width="35"  height="16"
                    forecolor="#CC0000" mode="Opaque" backcolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{Stok}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="333" y="0" width="40"  height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{Stok_Minimum}]]></textFieldExpression>
            </textField>

            <!-- Kekurangan — selalu positif -->
            <textField>
                <reportElement x="373" y="0" width="40"  height="16" backcolor="#FFF0F0" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[$F{Kekurangan} <= 0 ? "0" : String.valueOf($F{Kekurangan})]]>
                </textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="413" y="0" width="60"  height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Rp " + String.format("%,.0f", $F{Harga_Beli})]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="473" y="0" width="62"  height="16"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Rp " + String.format("%,.0f", $F{Harga_Jual})]]>
                </textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ═══════════ SUMMARY ═══════════ -->
    <summary>
        <band height="130">
            <line>
                <reportElement x="0" y="5" width="535" height="1"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

            <!-- Total barang kritis -->
            <staticText>
                <reportElement x="0" y="12" width="298" height="18" backcolor="#FFEEEE" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total Barang Kritis   ]]></text>
            </staticText>
            <textField>
                <reportElement x="298" y="12" width="237" height="18" backcolor="#FFEEEE" mode="Opaque"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[$V{JmlBarang} + " jenis barang"]]>
                </textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="35" width="535" height="1"/>
            </line>

            <!-- Catatan -->
            <staticText>
                <reportElement x="0" y="40" width="535" height="12"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[* Segera lakukan pemesanan kepada supplier untuk barang-barang di atas.]]></text>
            </staticText>

            <!-- Garis TTD -->
            <line>
                <reportElement x="0" y="57" width="535" height="1"/>
            </line>

            <!-- Tanggal kanan -->
            <textField>
                <reportElement x="300" y="62" width="235" height="13"/>
                <textElement textAlignment="Right">
                    <font fontName="Times New Roman" size="9"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Jakarta, " + new java.text.SimpleDateFormat(
                        "EEEE, dd MMMM yyyy", new java.util.Locale("id","ID")
                    ).format(new java.util.Date())]]>
                </textFieldExpression>
            </textField>

            <!-- Mengetahui (kiri) -->
            <staticText>
                <reportElement x="30" y="75" width="200" height="13"/>
                <textElement textAlignment="Center">
