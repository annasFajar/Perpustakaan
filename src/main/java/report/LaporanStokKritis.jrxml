<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
"http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="LaporanStokKritis"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20">

    <!-- QUERY -->
    <queryString>
        <![CDATA[
        SELECT
            b.Kode_Barang,
            b.Nama_Barang,
            b.Merk,
            b.Satuan,
            k.Nama_Kategori,
            s.Nama_Supplier,
            b.Stok,
            b.Stok_Minimum,
            b.Harga_Beli,
            b.Harga_Jual,
            (b.Stok_Minimum - b.Stok) AS Kekurangan
        FROM barang b
        LEFT JOIN kategori k  ON b.Kategori_ID_Kategori = k.ID_Kategori
        LEFT JOIN supplier s  ON b.Supplier_ID_Supplier = s.ID_Supplier
        WHERE b.Stok <= b.Stok_Minimum
        ORDER BY b.Stok ASC
        ]]>
    </queryString>

    <!-- FIELDS -->
    <field name="Kode_Barang"    class="java.lang.String"/>
    <field name="Nama_Barang"    class="java.lang.String"/>
    <field name="Merk"           class="java.lang.String"/>
    <field name="Satuan"         class="java.lang.String"/>
    <field name="Nama_Kategori"  class="java.lang.String"/>
    <field name="Nama_Supplier"  class="java.lang.String"/>
    <field name="Stok"           class="java.lang.Integer"/>
    <field name="Stok_Minimum"   class="java.lang.Integer"/>
    <field name="Harga_Beli"     class="java.lang.Double"/>
    <field name="Harga_Jual"     class="java.lang.Double"/>
    <field name="Kekurangan"     class="java.lang.Integer"/>

    <!-- VARIABLES -->
    <variable name="JmlBarang" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{Kode_Barang}]]></variableExpression>
    </variable>

    <!-- ═══════════ TITLE ═══════════ -->
    <title>
        <band height="130">
            <staticText>
                <reportElement x="0" y="5" width="535" height="22"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[TOKO SPARE PARTS PRO]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="28" width="535" height="13"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="9"/>
                </textElement>
                <text><![CDATA[Jl. Veteran No. 1, Jakarta Pusat  |  Telp. 081545826471]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="47" width="535" height="1"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="54" width="535" height="18"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[LAPORAN STOK KRITIS]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="72" width="535" height="13"/>
                <textElement textAlignment="Center">
                    <font fontName="Times New Roman" size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[(Barang dengan stok di bawah atau sama dengan stok minimum)]]></text>
            </staticText>
            <line>
                <reportElement x="150" y="90" width="235" height="1"/>
            </line>

            <!-- Tanggal cetak -->
            <staticText>
                <reportElement x="0" y="98" width="90" height="13"/>
                <textElement><font fontName="Times New Roman" size="9"/></textElement>
                <text><![CDATA[Tanggal Cetak]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="98" width="10" height="13"/>
                <textElement><font fontName="Times New Roman" size="9"/></textElement>
                <text><![CDATA[:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="98" width="200" height="13"/>
                <textElement><font fontName="Times New Roman" size="9" isBold="true"/></textElement>
                <textFieldExpression>
                    <![CDATA[new java.text.SimpleDateFormat("EEEE, dd MMMM yyyy",
                        new java.util.Locale("id","ID")).format(new java.util.Date())]]>
                </textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="116" width="535" height="1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
        </band>
    </title>

    <!-- ═══════════ COLUMN HEADER ═══════════ -->
    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement x="0"   y="0" width="18"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[NO]]></text>
            </staticText>
            <staticText>
                <reportElement x="18"  y="0" width="55"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[KODE]]></text>
            </staticText>
            <staticText>
                <reportElement x="73"  y="0" width="100" height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[NAMA BARANG]]></text>
            </staticText>
            <staticText>
                <reportElement x="173" y="0" width="60"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Times New Roman" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[KATEGORI]]></text>
            </staticText>
            <staticText>
                <reportElement x="233" y="0" width="65"  height="24" backcolor="#CC3333" mode="Opaque" forecolor="#FFFFFF"/>
